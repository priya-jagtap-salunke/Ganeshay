{
  "expo": {
    "name": "Ganeshay",
    "slug": "bappaji",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bappaji",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFAF5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bappaji.booking",
      "infoPlist": {
        "CFBundleDisplayName": "Ganeshay",
        "NSCameraUsageDescription": "Allow Ganeshay to use the camera to photograph the selected murti.",
        "NSPhotoLibraryUsageDescription": "Allow Ganeshay to access your photos to capture murti photos and set your business logo.",
        "NSPhotoLibraryAddUsageDescription": "Allow Ganeshay to save murti photos when needed.",
        "NSContactsUsageDescription": "Allow Ganeshay to read and save tele-calling contacts to your phone address book.",
        "LSApplicationQueriesSchemes": [
          "tel",
          "whatsapp",
          "whatsapp-business"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFAF5"
      },
      "package": "com.bappaji.booking",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_CALL_LOG",
        "android.permission.READ_PHONE_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "bappaji"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-document-picker",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Ganeshay to read and save tele-calling contacts to your phone address book."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Ganeshay to access your photos to capture murti photos and set your business logo.",
          "cameraPermission": "Allow Ganeshay to use the camera to photograph the selected murti."
        }
      ],
      "./plugins/withFmtXcodeFix.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "23525c93-6a89-426e-84a5-6321e3b90f6d"
      }
    },
    "owner": "bappajis-team"
  }
}
