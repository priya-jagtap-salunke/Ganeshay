+/**
+ * Render PDF pages into one tall image for WhatsApp.
+ * Invoice = 1 page. Catalogue = up to 6 pages (WhatsApp-only UTI, no Message ask).
+ */
+-(UIImage *)imageFromPDFAtPath:(NSString *)path {
+  NSURL *url = [NSURL fileURLWithPath:path];
+  if (!url) return nil;
+
+  CGPDFDocumentRef pdf = CGPDFDocumentCreateWithURL((__bridge CFURLRef)url);
+  if (!pdf) return nil;
+
+  size_t pageCount = CGPDFDocumentGetNumberOfPages(pdf);
+  if (pageCount < 1) {
+    CGPDFDocumentRelease(pdf);
+    return nil;
+  }
+
+  const size_t maxPages = 6;
+  size_t pagesToRender = pageCount < maxPages ? pageCount : maxPages;
+
+  CGPDFPageRef first = CGPDFDocumentGetPage(pdf, 1);
+  if (!first) {
+    CGPDFDocumentRelease(pdf);
+    return nil;
+  }
+  CGRect media = CGPDFPageGetBoxRect(first, kCGPDFMediaBox);
+  CGFloat maxSide = 1600.0;
+  CGFloat scale = MIN(maxSide / media.size.width, maxSide / media.size.height);
+  if (scale > 2.0) scale = 2.0;
+  if (scale < 0.5) scale = 0.5;
+
+  NSMutableArray<UIImage *> *pageImages = [NSMutableArray arrayWithCapacity:pagesToRender];
+  CGFloat totalHeight = 0;
+  CGFloat maxWidth = 0;
+  for (size_t i = 1; i <= pagesToRender; i++) {
+    CGPDFPageRef page = CGPDFDocumentGetPage(pdf, i);
+    if (!page) continue;
+    UIImage *img = [self renderPDFPage:page scale:scale];
+    if (!img) continue;
+    [pageImages addObject:img];
+    totalHeight += img.size.height;
+    if (img.size.width > maxWidth) maxWidth = img.size.width;
+  }
+  CGPDFDocumentRelease(pdf);
+
+  if (pageImages.count == 0) return nil;
+  if (pageImages.count == 1) return pageImages.firstObject;
+
+  // Cap tall catalogue stitch so memory stays reasonable (~12k px).
+  if (totalHeight > 12000.0) {
+    CGFloat shrink = 12000.0 / totalHeight;
+    maxWidth = floor(maxWidth * shrink);
+    totalHeight = 12000.0;
+    NSMutableArray<UIImage *> *scaled = [NSMutableArray arrayWithCapacity:pageImages.count];
+    for (UIImage *img in pageImages) {
+      CGSize s = CGSizeMake(floor(img.size.width * shrink), floor(img.size.height * shrink));
+      UIGraphicsBeginImageContextWithOptions(s, YES, 1.0);
+      [img drawInRect:CGRectMake(0, 0, s.width, s.height)];
+      UIImage *out = UIGraphicsGetImageFromCurrentImageContext();
+      UIGraphicsEndImageContext();
+      if (out) [scaled addObject:out];
+    }
+    pageImages = scaled;
+    totalHeight = 0;
+    maxWidth = 0;
+    for (UIImage *img in pageImages) {
+      totalHeight += img.size.height;
+      if (img.size.width > maxWidth) maxWidth = img.size.width;
+    }
+  }
+
+  UIGraphicsBeginImageContextWithOptions(CGSizeMake(maxWidth, totalHeight), YES, 1.0);
+  CGContextRef ctx = UIGraphicsGetCurrentContext();
+  if (!ctx) {
+    UIGraphicsEndImageContext();
+    return pageImages.firstObject;
+  }
+  CGContextSetRGBFillColor(ctx, 1.0, 1.0, 1.0, 1.0);
+  CGContextFillRect(ctx, CGRectMake(0, 0, maxWidth, totalHeight));
+  CGFloat y = 0;
+  for (UIImage *img in pageImages) {
+    [img drawAtPoint:CGPointMake(0, y)];
+    y += img.size.height;
+  }
+  UIImage *stitched = UIGraphicsGetImageFromCurrentImageContext();
+  UIGraphicsEndImageContext();
+  return stitched ?: pageImages.firstObject;
+}
