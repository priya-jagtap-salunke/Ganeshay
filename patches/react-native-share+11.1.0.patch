+-(NSString *)writeWhatsAppImage:(UIImage *)image {
+  if (!image) return nil;
+  NSString *documentsPath = [NSSearchPathForDirectoriesInDomains(NSDocumentDirectory, NSUserDomainMask, YES) objectAtIndex:0];
+  // .wai + net.whatsapp.image → only WhatsApp (no Messages in Open In).
+  NSString *filePath = [documentsPath stringByAppendingPathComponent:@"whatsAppShare.wai"];
+  NSData *jpeg = UIImageJPEGRepresentation(image, 0.88);
+  if (!jpeg) return nil;
+  if (![jpeg writeToFile:filePath atomically:YES]) return nil;
+  return filePath;
+}
