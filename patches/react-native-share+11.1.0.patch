+-(void)presentOpenInForFile:(NSString *)filePath uti:(NSString *)uti {
+  NSURL *fileURL = [NSURL fileURLWithPath:filePath];
+  documentInteractionController = [UIDocumentInteractionController interactionControllerWithURL:fileURL];
+  documentInteractionController.UTI = uti;
+  documentInteractionController.delegate = self;
+
+  UIViewController *root = [[[[UIApplication sharedApplication] delegate] window] rootViewController];
+  while (root.presentedViewController) {
+    root = root.presentedViewController;
+  }
+  UIView *rootView = root.view;
+  CGRect rect = CGRectMake(CGRectGetMidX(rootView.bounds), CGRectGetMidY(rootView.bounds), 1, 1);
+  [documentInteractionController presentOpenInMenuFromRect:rect inView:rootView animated:NO];
+}
+
+-(NSString *)writeWhatsAppImage:(UIImage *)image {
+  if (!image) return nil;
+  NSString *documentsPath = [NSSearchPathForDirectoriesInDomains(NSDocumentDirectory, NSUserDomainMask, YES) objectAtIndex:0];
+  // .wai + net.whatsapp.image → only WhatsApp (no Messages in Open In).
+  NSString *filePath = [documentsPath stringByAppendingPathComponent:@"whatsAppShare.wai"];
+  NSData *jpeg = UIImageJPEGRepresentation(image, 0.88);
+  if (!jpeg) return nil;
+  if (![jpeg writeToFile:filePath atomically:YES]) return nil;
+  return filePath;
+}
