+-(NSString *)filePathFromOptions:(NSDictionary *)options {
+  NSString *urlString = [RCTConvert NSString:options[@"url"]];
+  if (!urlString || urlString.length == 0) {
+    return nil;
+  }
+  if ([urlString hasPrefix:@"file://"]) {
+    NSString *path = [urlString substringFromIndex:7];
+    if ([path hasPrefix:@"//"]) {
+      path = [path substringFromIndex:1];
+    }
+    NSString *decoded = [path stringByRemovingPercentEncoding];
+    return decoded.length ? decoded : path;
+  }
+  return urlString;
+}
+
+-(NSString *)pdfSharePathFromOptions:(NSDictionary *)options sourcePath:(NSString *)path {
+  NSFileManager *fm = [NSFileManager defaultManager];
+  if (![fm fileExistsAtPath:path]) {
+    return nil;
+  }
+
+  NSString *documentsPath = [NSSearchPathForDirectoriesInDomains(NSDocumentDirectory, NSUserDomainMask, YES) objectAtIndex:0];
+  NSString *fileName = [RCTConvert NSString:options[@"filename"]];
+  if (!fileName.length) {
+    fileName = [path lastPathComponent];
+  }
+  if (!fileName.length) {
+    fileName = @"document.pdf";
+  }
+  // Strip any wrong extension, then force .pdf so WhatsApp attaches a PDF.
+  NSString *base = [[fileName lastPathComponent] stringByDeletingPathExtension];
+  if (!base.length) {
+    base = @"document";
+  }
+  fileName = [base stringByAppendingPathExtension:@"pdf"];
+
+  NSString *destPath = [documentsPath stringByAppendingPathComponent:fileName];
+  if ([destPath isEqualToString:path] && [[path lowercaseString] hasSuffix:@".pdf"]) {
+    return path;
+  }
+
+  NSError *error = nil;
+  if ([fm fileExistsAtPath:destPath]) {
+    [fm removeItemAtPath:destPath error:nil];
+  }
+  if (![fm copyItemAtPath:path toPath:destPath error:&error]) {
+    // Fall back to original only when it already ends with .pdf.
+    if ([[path lowercaseString] hasSuffix:@".pdf"]) {
+      return path;
+    }
+    return nil;
+  }
+  return destPath;
+}
