+-(void)openCustomerChatIfNeeded:(NSDictionary *)options {
+  NSString *whatsAppNumber = [RCTConvert NSString:options[@"whatsAppNumber"]];
+  if (!whatsAppNumber || whatsAppNumber.length == 0) {
+    return;
+  }
+  // Same as Android jid: land on this customer's chat before attaching media.
+  NSString *openChat = [NSString stringWithFormat:@"whatsapp://send?phone=%@", whatsAppNumber];
+  NSURL *chatURL = [NSURL URLWithString:openChat];
+  if (chatURL && [[UIApplication sharedApplication] canOpenURL:chatURL]) {
+    [[UIApplication sharedApplication] openURL:chatURL options:@{} completionHandler:nil];
+  }
+}
+
+-(NSString *)filePathFromOptions:(NSDictionary *)options {
+  NSString *urlString = [RCTConvert NSString:options[@"url"]];
+  if (!urlString || urlString.length == 0) {
+    return nil;
+  }
+  if ([urlString hasPrefix:@"file://"]) {
+    NSString *path = [urlString substringFromIndex:7];
+    if ([path hasPrefix:@"//"]) {
+      path = [path substringFromIndex:1];
+    }
+    return path;
+  }
+  return urlString;
+}
