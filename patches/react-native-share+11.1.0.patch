+/**
+ * Open WhatsApp only — never the system share sheet (Message / Facebook / Instagram).
+ * Uses whatsapp:// URL scheme so iOS does not ask which app to use.
+ * Image is placed on the pasteboard so it can be pasted in the opened chat.
+ * Also presents WhatsApp-exclusive Open In (net.whatsapp.image) which auto-opens
+ * WhatsApp when it is the only handler — still never a multi-app sheet fallback.
+ */
+-(void)shareToWhatsAppOnly:(NSString *)filePath options:(NSDictionary *)options {
+  NSString *whatsAppNumber = [RCTConvert NSString:options[@"whatsAppNumber"]];
+
+  UIImage *image = [UIImage imageWithContentsOfFile:filePath];
+  if (!image) {
+    NSData *data = [NSData dataWithContentsOfFile:filePath];
+    image = data ? [UIImage imageWithData:data] : nil;
+  }
+  if (image) {
+    [[UIPasteboard generalPasteboard] setImage:image];
+  }
+
+  // 1) Always open WhatsApp (or Business) directly — no Message/FB/IG chooser.
+  NSString *consumerUrl = whatsAppNumber.length > 0
+    ? [NSString stringWithFormat:@"whatsapp://send?phone=%@", whatsAppNumber]
+    : @"whatsapp://send";
+  NSString *businessUrl = whatsAppNumber.length > 0
+    ? [NSString stringWithFormat:@"whatsapp-business://send?phone=%@", whatsAppNumber]
+    : @"whatsapp-business://send";
+
+  NSURL *openURL = nil;
+  if ([[UIApplication sharedApplication] canOpenURL:[NSURL URLWithString:@"whatsapp://send"]]) {
+    openURL = [NSURL URLWithString:consumerUrl];
+  } else if ([[UIApplication sharedApplication] canOpenURL:[NSURL URLWithString:@"whatsapp-business://send"]]) {
+    openURL = [NSURL URLWithString:businessUrl];
+  }
+
+  if (openURL) {
+    [[UIApplication sharedApplication] openURL:openURL options:@{} completionHandler:nil];
+    return;
+  }
+
+  // 2) Last resort: WhatsApp-only UTI Open In (should list WhatsApp alone).
+  NSURL *fileURL = [NSURL fileURLWithPath:filePath];
+  documentInteractionController = [UIDocumentInteractionController interactionControllerWithURL:fileURL];
+  documentInteractionController.UTI = @"net.whatsapp.image";
+  documentInteractionController.delegate = self;
+
+  UIViewController *root = [[[[UIApplication sharedApplication] delegate] window] rootViewController];
+  while (root.presentedViewController) {
+    root = root.presentedViewController;
+  }
+  UIView *rootView = root.view;
+  CGRect rect = CGRectMake(CGRectGetMidX(rootView.bounds), CGRectGetMidY(rootView.bounds), 1, 1);
+  [documentInteractionController presentOpenInMenuFromRect:rect inView:rootView animated:NO];
+}
