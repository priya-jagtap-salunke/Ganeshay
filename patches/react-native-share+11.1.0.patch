+/**
+ * PDF → image, then open WhatsApp directly (no Message / Facebook / Instagram sheet).
+ */
+-(void)tryToSendDocument:(NSDictionary *)options
+                 resolve:(RCTPromiseResolveBlock)resolve
+                  reject:(RCTPromiseRejectBlock)reject {
+  NSString *path = [self filePathFromOptions:options];
+  if (!path) {
+    return [self handleError:@"Something went wrong" code:2 rejectFn:reject];
+  }
+
+  dispatch_async(dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_DEFAULT, 0), ^{
+    UIImage *pageImage = [self imageFromPDFAtPath:path];
+    NSString *filePath = pageImage ? [self writeWhatsAppImage:pageImage] : nil;
+
+    dispatch_async(dispatch_get_main_queue(), ^{
+      if (!filePath) {
+        [self openCustomerChatIfNeeded:options];
+        NSString *whatsAppNumber = [RCTConvert NSString:options[@"whatsAppNumber"]];
+        if (whatsAppNumber.length > 0) {
+          resolve(@[@true, @""]);
+          return;
+        }
+        [self handleError:@"Could not prepare PDF for WhatsApp" code:2 rejectFn:reject];
+        return;
+      }
+
+      [self shareToWhatsAppOnly:filePath options:options];
+      resolve(@[@true, @""]);
+    });
+  });
+}
